{
  "name": "@voltex/web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --port 3000",
    "build": "next build && node ../scripts/prepare-frontend.mjs",
    "start": "node --env-file-if-exists=.env.local .next/standalone/frontend/server.js",
    "lint": "eslint .",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --test \"src/**/*.test.ts\""
  },
  "dependencies": {
    "@gsap/react": "^2.1.2",
    "@voltex/shared": "*",
    "clsx": "^2.1.1",
    "gsap": "^3.15.1",
    "lucide-react": "^1.68.0",
    "motion": "^14.9.1",
    "next": "16.4.5",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "server-only": "^0.0.1"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^24.19.2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^10.14.0",
    "eslint-config-next": "16.4.5",
    "tailwindcss": "^4",
    "typescript": "^6.0.3"
  }
}
