# Copy to .env and fill in. Never commit the real .env.
NODE_ENV=development
PORT=4000
DATABASE_URL=postgresql://voltex:CHANGE_ME@localhost:5432/voltex?schema=public
# Used only by `npm test` (the database name must contain "test")
TEST_DATABASE_URL=postgresql://voltex:CHANGE_ME@localhost:5432/voltex_test?schema=public
# At least 32 random characters, e.g. `openssl rand -base64 48`
JWT_SECRET=CHANGE_ME
# The site's own origin(s), comma-separated
CORS_ORIGIN=http://localhost:3000
SITE_URL=http://localhost:3000
UPLOAD_DIR=./uploads
# 1 behind Nginx in production
TRUST_PROXY=0
AUTO_SEED=true
# Student Lab compiler (optional). Point at arduino-cli with the arduino:avr and rp2040:rp2040 cores and the
# Servo, LiquidCrystal, LiquidCrystal I2C, Adafruit SSD1306 and Adafruit GFX Library libraries installed. Unset =
# compiling off. On start the API builds each core once per compile slot in the background (minutes for RP2040);
# after that a compile takes seconds.
# ARDUINO_CLI=/opt/arduino/arduino-cli
# ARDUINO_DATA_DIR=/opt/arduino/data
# ARDUINO_USER_DIR=/opt/arduino/user
# COMPILE_TIMEOUT_MS=60000
# COMPILE_CONCURRENCY=2
# Used by `npm run admin:create -w @voltex/api` to create/reset the admin login (password: 12+ characters)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=CHANGE_ME
