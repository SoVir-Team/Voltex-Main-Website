# Copy to .env and fill in. Never commit the real .env.
NODE_ENV=development
PORT=4000
DATABASE_URL=postgresql://voltex:CHANGE_ME@localhost:5432/voltex?schema=public
# Used only by `npm test` (the database name must contain "test")
TEST_DATABASE_URL=postgresql://voltex:CHANGE_ME@localhost:5432/voltex_test?schema=public
# At least 32 random characters, e.g. `openssl rand -base64 48`
JWT_SECRET=CHANGE_ME
# The site's own origin(s), comma-separated
CORS_ORIGIN=http://localhost:3000
SITE_URL=http://localhost:3000
UPLOAD_DIR=./uploads
# 1 behind Nginx in production
TRUST_PROXY=0
AUTO_SEED=true
# Used by `npm run admin:create -w @voltex/api` to create/reset the admin login (password: 12+ characters)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=CHANGE_ME
